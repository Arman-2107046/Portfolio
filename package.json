{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "npm run lint && npm run typecheck && npm run check:contrast && npm run check:content && npm run build",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:content": "tsx scripts/check-content.mts",
    "media": "tsx scripts/generate-placeholders.mts",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:keyboard": "node scripts/audit-keyboard.mjs",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit:responsive": "node scripts/audit-responsive.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.4.4",
    "lenis": "^1.3.26",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
